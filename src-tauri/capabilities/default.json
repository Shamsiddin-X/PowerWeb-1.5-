{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "dialog:default",
    "shell:default",
    "shell:allow-open",
    "opener:default",
    "process:default"
  ]
}
